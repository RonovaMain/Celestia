    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_desc">Offline voice changer based on RVC v2. Everything runs on the device: no internet, no cloud, no telemetry.</string>
    <string name="about_author">Author: RonovaDev</string>
    <string name="lang_ui_label">Interface language</string>
    <string name="lang_label">Language</string>
    <string name="lang_system">System default</string>
    <string name="lang_ui_hint">“System default” picks Russian, English, Belarusian or Ukrainian to match your phone\'s language (English for any other language).</string>
    <string name="tts_title">Text to speech</string>
    <string name="tts_intro">Type some text — a speech synthesizer reads it out, then the voice is swapped for the RVC voice you picked. The models run strictly one after another: first the synthesizer (it is then unloaded), then RVC — they are never in memory together.</string>
    <string name="tts_text_label">Text to speak</string>
    <string name="tts_chars">Characters: %1$d</string>
    <string name="tts_step1">1. Speech synthesizer (base)</string>
    <string name="tts_embedded">Built-in</string>
    <string name="tts_system">System</string>
    <string name="tts_emb_hint">Works without internet and without system voices. Kokoro-82M: English, Spanish, French, Italian, Portuguese, Hindi. Kokoro can\'t do Russian — Piper is built in for that. RVC replaces the timbre afterwards, so only clarity and intonation matter.</string>
    <string name="tts_voice_missing">This voice is not bundled in this build (check the sherpa-onnx step in the CI log).</string>
    <string name="tts_rate">Speech rate</string>
    <string name="tts_sys_hint">Uses the offline voices installed in the system (Google, Samsung, etc.). Chinese firmwares often have none — then choose “Built-in”.</string>
